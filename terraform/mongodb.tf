# MongoDB for the Management API and the gateway rate-limit store.
#
# Official image, pinned in terraform.tfvars. Authentication is on and data is
# kept on a PersistentVolumeClaim. On first start an application user limited to
# one database is created, and Gravitee connects with that user, not with root.
# Passwords are generated by Terraform and stored in Kubernetes Secrets.

locals {
  mongodb_name       = "gravitee-mongodb"
  mongodb_uri_secret = "gravitee-mongodb-uri" # referenced by api.env and gateway.env in terraform.tfvars
  mongodb_host       = "${local.mongodb_name}.${kubernetes_namespace_v1.gravitee.metadata[0].name}.svc.cluster.local"
  mongodb_labels     = { app = local.mongodb_name }
}

resource "random_password" "mongodb_root" {
  length  = 32
  special = false
}

resource "random_password" "mongodb_app" {
  length  = 32
  special = false
}

resource "kubernetes_secret_v1" "mongodb" {
  metadata {
    name      = local.mongodb_name
    namespace = kubernetes_namespace_v1.gravitee.metadata[0].name
  }

  data = {
    root-password = random_password.mongodb_root.result
    app-password  = random_password.mongodb_app.result
  }
}

# Connection string for Gravitee. The Management API and the gateway read it
# from this Secret through an environment variable, so the password never
# appears in a ConfigMap or in the Helm values.
resource "kubernetes_secret_v1" "mongodb_uri" {
  metadata {
    name      = local.mongodb_uri_secret
    namespace = kubernetes_namespace_v1.gravitee.metadata[0].name
  }

  data = {
    uri = "mongodb://${var.mongodb.username}:${random_password.mongodb_app.result}@${local.mongodb_host}:27017/${var.mongodb.database}?authSource=${var.mongodb.database}&serverSelectionTimeoutMS=5000&connectTimeoutMS=5000"
  }
}

# Runs once, on the first start with an empty data directory.
resource "kubernetes_config_map_v1" "mongodb_init" {
  metadata {
    name      = "${local.mongodb_name}-init"
    namespace = kubernetes_namespace_v1.gravitee.metadata[0].name
  }

  data = {
    "10-app-user.js" = <<-EOT
      const dbName = process.env.MONGODB_APP_DATABASE;
      db.getSiblingDB(dbName).createUser({
        user: process.env.MONGODB_APP_USER,
        pwd: process.env.MONGODB_APP_PASSWORD,
        roles: [
          { role: "readWrite", db: dbName },
          { role: "dbAdmin", db: dbName },
        ],
      });
    EOT
  }
}

# Headless Service: one replica, so clients connect straight to the pod.
resource "kubernetes_service_v1" "mongodb" {
  metadata {
    name      = local.mongodb_name
    namespace = kubernetes_namespace_v1.gravitee.metadata[0].name
  }

  spec {
    cluster_ip = "None"
    selector   = local.mongodb_labels

    port {
      name        = "mongodb"
      port        = 27017
      target_port = 27017
    }
  }
}

resource "kubernetes_stateful_set_v1" "mongodb" {
  metadata {
    name      = local.mongodb_name
    namespace = kubernetes_namespace_v1.gravitee.metadata[0].name
    labels    = local.mongodb_labels
  }

  spec {
    service_name = kubernetes_service_v1.mongodb.metadata[0].name
    replicas     = 1

    selector {
      match_labels = local.mongodb_labels
    }

    template {
      metadata {
        labels = local.mongodb_labels
      }

      spec {
        automount_service_account_token  = false
        termination_grace_period_seconds = 30

        security_context {
          run_as_non_root = true
          run_as_user     = 999
          run_as_group    = 999
          fs_group        = 999
          seccomp_profile {
            type = "RuntimeDefault"
          }
        }

        container {
          name              = "mongodb"
          image             = var.mongodb.image
          image_pull_policy = "IfNotPresent"

          env {
            name  = "MONGO_INITDB_ROOT_USERNAME"
            value = "root"
          }
          env {
            name = "MONGO_INITDB_ROOT_PASSWORD"
            value_from {
              secret_key_ref {
                name = kubernetes_secret_v1.mongodb.metadata[0].name
                key  = "root-password"
              }
            }
          }
          env {
            name  = "MONGODB_APP_DATABASE"
            value = var.mongodb.database
          }
          env {
            name  = "MONGODB_APP_USER"
            value = var.mongodb.username
          }
          env {
            name = "MONGODB_APP_PASSWORD"
            value_from {
              secret_key_ref {
                name = kubernetes_secret_v1.mongodb.metadata[0].name
                key  = "app-password"
              }
            }
          }

          port {
            name           = "mongodb"
            container_port = 27017
          }

          volume_mount {
            name       = "data"
            mount_path = "/data/db"
          }
          volume_mount {
            name       = "init"
            mount_path = "/docker-entrypoint-initdb.d"
            read_only  = true
          }

          resources {
            requests = var.mongodb.resources.requests
            limits   = var.mongodb.resources.limits
          }

          # TCP probes use the pod IP. During first-start setup the server only
          # listens on localhost, so the pod is not ready until setup is done.
          readiness_probe {
            tcp_socket {
              port = 27017
            }
            initial_delay_seconds = 5
            period_seconds        = 5
          }

          liveness_probe {
            tcp_socket {
              port = 27017
            }
            initial_delay_seconds = 30
            period_seconds        = 20
          }

          security_context {
            allow_privilege_escalation = false
            capabilities {
              drop = ["ALL"]
            }
          }
        }

        volume {
          name = "init"
          config_map {
            name         = kubernetes_config_map_v1.mongodb_init.metadata[0].name
            default_mode = "0444"
          }
        }
      }
    }

    volume_claim_template {
      metadata {
        name = "data"
      }
      spec {
        access_modes = ["ReadWriteOnce"]
        resources {
          requests = {
            storage = var.mongodb.storage_size
          }
        }
      }
    }
  }
}
